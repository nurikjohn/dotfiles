{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [
    "@ex-machina/opencode-anthropic-auth@1.7.5",
    "@mohak34/opencode-notifier@latest"
  ],
  "permission": {
    "websearch": "allow"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Remote Server)",
