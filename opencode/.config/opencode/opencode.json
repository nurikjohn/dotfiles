  "agent": {
    "search": {
      "description": "A web search agent that searches documentation and answers questions by gathering information from the internet, technical docs, and reference materials. It specializes in finding answers to technical questions, product specifications, documentation lookups, and cross-referencing multiple sources.",
      "mode": "subagent",
      "model": "ollama/gemma4:26b",
      "prompt": "{file:./prompts/search.txt}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "websearch": "allow"
      },
      "color": "success",
      "disable": true
