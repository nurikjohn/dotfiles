            "output": 2048
          },
          "options": {
            "reasoningEffort": "none"
          },
          "variants": {
            "fast": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
